# Neon — projeto "delivery-assistant", regiao AWS US East 1 (N. Virginia).
#
# Sao a MESMA string, diferindo so pelo sufixo "-pooler" no host:
#
#   DATABASE_URL           -> host COM  "-pooler"  (aplicacao)
#   DATABASE_URL_UNPOOLED  -> host SEM  "-pooler"  (migrations)
#
# Por que dois: a aplicacao usa PgBouncer em transaction mode (suporta muitas
# conexoes simultaneas, ideal para serverless), mas esse modo nao aceita os
# comandos de DDL/sessao que o drizzle-kit emite nas migrations.
#
# Banco em us-east-1 => a API deve ficar em iad1 (default da Vercel). NAO
# trocar para gru1, senao a API fica longe do banco.

DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Autenticacao — HMAC do codigo OTP. Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Resend. Se vazio em desenvolvimento, o codigo e impresso no console do servidor.
# Obrigatorio em producao (NODE_ENV=production falha sem ele).
RESEND_API_KEY=""
EMAIL_REMETENTE="Precifica <login@seu-dominio.com>"

# Origens permitidas no CORS, separadas por virgula.
CORS_ORIGINS="http://localhost:5173"
