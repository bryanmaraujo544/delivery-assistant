    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "resend": "^6.20.0",
    "tailwindcss": "^4.3.3",
